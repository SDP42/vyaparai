# Copy to .env (never commit it). Values below are placeholders.
POSTGRES_PASSWORD=change-me-to-a-long-random-string
# python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=change-me-to-48-random-characters-or-more
# The address people open (https only) and the API address the browser calls.
PUBLIC_URL=https://shop.example.in
PUBLIC_API_URL=https://shop.example.in/api/v1
# Optional: owner digest and reminder email.
SMTP_HOST=
SMTP_USER=
SMTP_PASSWORD=
