# Copy to .env and adjust. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./vyapar_dev.db
# PostgreSQL example: postgresql+psycopg://vyapar:vyapar@localhost:5432/vyapar
JWT_SECRET_KEY=replace-with-output-of: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
LOG_JSON=false
MAX_UPLOAD_SIZE_MB=25
