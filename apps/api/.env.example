# Copy to .env and adjust. Never commit .env.
APP_ENV=development
DATABASE_URL=sqlite:///./vyapar_dev.db
# PostgreSQL example: postgresql+psycopg://vyapar:vyapar@localhost:5432/vyapar
JWT_SECRET_KEY=replace-with-output-of: python -c "import secrets; print(secrets.token_urlsafe(48))"
ACCESS_TOKEN_EXPIRE_MINUTES=30
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO
LOG_JSON=false
MAX_UPLOAD_SIZE_MB=25

# One-tap sample accounts per persona on the sign-in page. Development only: refused when APP_ENV=production.
DEMO_LOGIN_ENABLED=false
# Voice questions (speech to text on this server, audio is never stored).
# Whisper size: tiny | base | small | medium. medium understands Hindi best (about 1.5 GB, a few seconds per question);
# small is faster and lighter but mishears more. Weights download on first use unless STT_LOCAL_FILES_ONLY=true.
VOICE_ENABLED=true
STT_MODEL=medium
STT_LOCAL_FILES_ONLY=false
