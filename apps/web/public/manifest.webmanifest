{
  "name": "Vyapar AI",
  "short_name": "Vyapar",
  "description": "Your shop's numbers, forecasts and next steps.",
  "id": "/app",
  "start_url": "/app",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f6efe2",
  "theme_color": "#f6efe2",
  "lang": "en-IN",
  "icons": [
    { "src": "/icons/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icons/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    { "name": "Ask", "url": "/app/ask", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Alerts", "url": "/app/alerts", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] },
    { "name": "Udhaar", "url": "/app/udhaar", "icons": [{ "src": "/icons/icon-192.png", "sizes": "192x192" }] }
  ]
}
